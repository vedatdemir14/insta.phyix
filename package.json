{
  "name": "instagram-scraper-app",
  "version": "1.0.0",
  "description": "Instagram Scraper with React Frontend and FastAPI Backend",
  "main": "api.py",
  "scripts": {
    "start": "uvicorn api:app --host 0.0.0.0 --port $PORT",
    "dev": "uvicorn api:app --reload --host 0.0.0.0 --port 8000",
    "frontend:start": "cd frontend && npm start",
    "frontend:build": "cd frontend && npm run build",
    "frontend:install": "cd frontend && npm install"
  },
  "dependencies": {
    "fastapi": "^0.104.0",
    "uvicorn": "^0.24.0",
    "pandas": "^1.5.0",
    "requests": "^2.28.0",
    "apify-client": "^1.6.0",
    "supabase": "^2.0.0",
    "python-dotenv": "^1.0.0",
    "selenium": "^4.15.0",
    "webdriver-manager": "^4.0.0",
    "psycopg2-binary": "^2.9.0",
    "matplotlib": "^3.5.0",
    "pydantic": "^2.0.0"
  },
  "engines": {
    "python": "3.9"
  }
}
